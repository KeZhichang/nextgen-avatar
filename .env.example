# ===== Frontend Public Environment Variables (.env.local) =====
# Set to "mock" to force local demo/mock mode even when Supabase keys are set
# VITE_DATA_MODE=mock

# Supabase (US region project)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe publishable key (pk_test_... for sandbox, pk_live_... for production)
VITE_STRIPE_PREVIEW_PUBLISHABLE_KEY=

# Local Vite Stripe preview middleware secret (dev only; production uses Edge Functions)
STRIPE_PREVIEW_SECRET_KEY=

# ===== Server / Supabase Edge Function Secrets (set via `supabase secrets set`) =====
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# RESEND_API_KEY=
# MAIL_FROM="NextGen Avatar <noreply@yourdomain.com>"
