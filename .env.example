# ===== Frontend Public Environment Variables (.env.local) =====
# Set to "mock" to force local demo/mock mode even when Supabase keys are set
# VITE_DATA_MODE=mock
# Set to "true" in production launch to hide sample orders and demo login prefill
# VITE_HIDE_SAMPLE_DATA=true

# Supabase (US region project)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe publishable key (pk_test_... for sandbox, pk_live_... for production)
VITE_STRIPE_PREVIEW_PUBLISHABLE_KEY=

# Local Vite Stripe preview middleware secret (dev only; production uses Server/Webhook)
STRIPE_PREVIEW_SECRET_KEY=

# ===== Server / Vercel Function & Webhook Secrets =====
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_PUBLIC_URL=https://nextgenavatar.com
# INTERNAL_API_SECRET=
# Cloudflare R2 (leave empty to fall back automatically to Supabase Storage)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=nextgen-avatar-media
# R2_ENDPOINT=
# Resend transactional email
# RESEND_API_KEY=
# MAIL_FROM="NextGen Avatar <support@nextgenavatar.com>"
