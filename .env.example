# ===== Frontend Public Environment Variables (.env.local) =====
# App environment: "test" enables test quick sign-in buttons & cross-portal test links;
# "production" (default in `vite build` / Vercel Prod) hides all test shortcuts & admin links on client login.
# VITE_APP_ENV=production
# Set to "mock" to force offline local demo mode even when Supabase keys are set
# VITE_DATA_MODE=mock

# Optional external marketing site URL (e.g. https://nextgenavatar.com for dual-site setup)
# VITE_MARKETING_SITE_URL=https://nextgenavatar.com

# Supabase (US region project)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe publishable key (supports pk_live_... for production or pk_test_... for sandbox)
VITE_STRIPE_PUBLISHABLE_KEY=
# Legacy alias (still supported if VITE_STRIPE_PUBLISHABLE_KEY is unset)
VITE_STRIPE_PREVIEW_PUBLISHABLE_KEY=

# Local Vite Stripe sandbox middleware secret (dev test mode only)
STRIPE_PREVIEW_SECRET_KEY=

# ===== Server / Vercel Function & Webhook Secrets =====
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# APP_PUBLIC_URL=https://nextgenavatar.com
# INTERNAL_API_SECRET=
# Cloudflare R2 (leave empty to fall back automatically to Supabase Storage)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=nextgen-avatar-media
# R2_ENDPOINT=
# Resend transactional email
# RESEND_API_KEY=
# MAIL_FROM="NextGen Avatar <support@nextgenavatar.com>"
